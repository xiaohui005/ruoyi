onst normalized = normalizeLayout(layout);\n\treturn normalized === \"header-nav\" || normalized === \"mixed-nav\" || normalized === \"header-mixed-nav\";\n};\nexport const isMixedNavLayout = (layout) => {\n\treturn normalizeLayout(layout) === \"mixed-nav\";\n};\nexport const isHeaderMixedNavLayout = (layout) => {\n\treturn normalizeLayout(layout) === \"header-mixed-nav\";\n};\nexport const isTwoColumnLayout = (layout) => {\n\tconst normalized = normalizeLayout(layout);\n\treturn normalized === \"sidebar-mixed-nav\" || normalized === \"header-mixed-nav\";\n};\nexport const getRootPath = (path = \"/\") => {\n\tif (!path || path === \"/\") {\n\t\treturn \"/\";\n\t}\n\tconst segments = path.split(\"/\").filter(Boolean);\n\treturn segments.length ? `/${segments[0]}` : \"/\";\n};\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":1.255},"_resourceType":"script"},{"startedDateTime":"2026-07-03T15:45:32.816Z","time":0.929,"request":{"method":"GET","url":"http://localhost/src/styles/global.module.scss","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost"},{"name":"Origin","value":"http://localhost"},{"name":"Referer","value":"http://localhost/src/hooks/web/useDesign.ts"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":-1,"bodySize":-1},"res