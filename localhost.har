":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Origin","value":"http://localhost"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"20416"},{"name":"Content-Type","value":"text/javascript"},{"name":"Date","value":"Fri, 03 Jul 2026 15:45:33 GMT"},{"name":"Etag","value":"W/\"18a5-glE61lEHz0Qsv15RbTPfkCJshDw\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Vary","value":"Origin"}],"content":{"size":-1,"mimeType":"text/javascript","text":"/**\n* 判断是否 十六进制颜色值.\n* 输入形式可为 #fff000 #f00\n*\n* @param   String  color   十六进制颜色值\n* @return  Boolean\n*/\nexport const isHexColor = (color) => {\n\tconst reg = /^#([0-9a-fA-F]{3}|[0-9a-fA-f]{6})$/;\n\treturn reg.test(color);\n};\n/**\n* RGB 颜色值转换为 十六进制颜色值.\n* r, g, 和 b 需要在 [0, 255] 范围内\n*\n* @return  String          类似#ff00ff\n* @param r\n* @param g\n* @param b\n*/\nexport const rgbToHex = (r, g, b) => {\n\t// tslint:disable-next-line:no-bitwise\n\tconst hex = (r << 16 | g << 8 | b).toString(16);\n\treturn \"#\" + new Array(Math.abs(hex.length - 7)).join(\"0\") + hex;\n};\n/**\n* Transform a HEX color to its RGB representation\n* @param {string} hex The color to transform\n* @returns The RGB representation of the passed color\n*/\nexport const hexToRGB = (hex, opacity) => {\n\tlet sHex = hex.toLowerCase();\n\tif (isHexColor(hex)) {\n\t\tif (sHex.length === 4) {\n\t\t\tlet sColorNew = \"#\";\n\t\t\tfor (let i = 1; i < 4; i += 1) {\n\t\t\t\tsColorNew += sHex.slice(i, i + 1).concat(sHex.slic