ne\", \"VITE_DEV\": \"true\", \"VITE_DROP_CONSOLE\": \"false\", \"VITE_DROP_DEBUGGER\": \"false\", \"VITE_GOVIEW_URL\": \"http://127.0.0.1:3000\", \"VITE_MALL_H5_DOMAIN\": \"http://localhost:3000\", \"VITE_OPEN\": \"true\", \"VITE_PORT\": \"80\", \"VITE_SOURCEMAP\": \"false\", \"VITE_UPLOAD_TYPE\": \"server\", \"VITE_USER_NODE_ENV\": \"development\"};import * as FileApi from \"/src/api/infra/file/index.ts?t=1783089101375\";\nimport axios from \"/node_modules/.vite/deps/axios.js?v=f57a2900\";\n/**\n* 获得上传 URL\n*/\nexport const getUploadUrl = () => {\n\treturn import.meta.env.VITE_BASE_URL + import.meta.env.VITE_API_URL + \"/infra/file/upload\";\n};\nexport const useUpload = (directory) => {\n\t// 后端上传地址\n\tconst uploadUrl = getUploadUrl();\n\t// 是否使用前端直连上传\n\tconst isClientUpload = UPLOAD_TYPE.CLIENT === import.meta.env.VITE_UPLOAD_TYPE;\n\t// 重写ElUpload上传方法\n\tconst httpRequest = async (options) => {\n\t\t// 文件上传进度监听\n\t\tconst uploadProgressHandler = (evt) => {\n\t\t\tconst upEvt = Object.assign(evt.event);\n\t\t\tupEvt.percent = evt.progress ? evt.progress * 100 : 0;\n\t\t\toptions.onProgress?.(upEvt);\n\t\t};\n\t\t// 模式一：前端上传\n\t\tif (isClientUpload) {\n\t\t\t// 1.1 生成文件名称\n\t\t\tconst fileName = options.file.name || options.filename;\n\t\t\t// 1.2 获取文件预签名地址\n\t\t\tconst presignedInfo = await FileApi.getFilePresignedUrl(fileName, directory);\n\t\t\t// 1.3 上传文件（不能使用 ElUpload 的 ajaxUpload 方法的原因：其使用的是 FormData 上传，Minio 不支持）\n\t\t\treturn axios.put(presignedInfo.uploadUrl, options.file, {\n\t\t\t\theaders: { \"Content-Type\": options.file.type || \"application/octet-stream\" },\n\t\t\t\tonUploadProgress: uploadProgressHandler\n\t\t\t}).then(() => {\n\t\t\t\t// 1.4. 记录文件信息到后端（异步）\n\t\t\t\tcreateFile(presignedInfo, options.file, fileName);\n\t\t\t\t// 通知成功，数据格式保持与后端上传的返回结果一致\n\t\t\t\treturn { data: presignedInfo.url };\n\t\t\t});\n\t\t} else {\n\t\t\t// 模式二：后端上传\n\t\t\t// 重写 el-upload httpRequest 文件上传成功会走成功的钩子，失败走失败的钩子\n\t\t\treturn new Promise((resolve, reject) => {\n\t\t\t\tFileApi.updateFile({\n\t\t\t\t\tfile: options.file,\n\t\t\t\t\tdirectory\n\t\t\t\t}, uploadProgressHandler).then((res) => {\n\t\t\t\t\tif (res.code === 0) {\n\t\t\t\t\t\tresolve(res);\n\t\t\t\t\t} else {\n\t\t\t\t\t\treject(res);\n\t\t\t\t\t}\n\t\t\t\t}).catch((res) => {\n\t\t\t\t\treject(res);\n\t\t\t\t});\n\t\t\t});\n\t\t}\n\t};\n\treturn {\n\t\tuploadUrl,\n\t\thttpRequest\n\t};\n};\n/**\n* 创建文件信息\n* @param vo 文件预签名信息\n* @param file 文件\n* @param fileName\n*/\nfunction createFile(vo, file, fileName) {\n\tconst fileVo = {\n\t\tconfigId: vo.configId,\n\t\turl: vo.url,\n\t\tpath: vo.path,\n\t\tname: fileName,\n\t\ttype: file.type || \"application/octet-stream\",\n\t\tsize: file.size\n\t};\n\tFileApi.createFile(fileVo);\n\treturn fileVo;\n}\n/**\n* 上传类型\n*/\nvar UPLOAD_TYPE = /* @__PURE__ */ function(UPLOAD_TYPE) {\n\t// 客户端直接上传（只支持S3服务）\n\tUPLOAD_TYPE[\"CLIENT\"] = \"client\";\n\t// 客户端发送到后端上传\n\tUPLOAD_TYPE[\"SERVER\"] = \"server\";\n\treturn UPLOAD_TYPE;\n}(UPLOAD_TYPE || {});\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":1.028},"_resourceType":"script"},{"startedDateTime":"2026-07-03T15:45:33.108Z","time":1.299,"request":{"method":"GET","url":"http://localhost/src/hooks/web/useMessage.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost"},{"name":"Origin","value":"http://localhost"},{"name":"Referer","value":"http://localhost/src/components/UploadFile/src/UploadFile.vue?t=1783089101375"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"se