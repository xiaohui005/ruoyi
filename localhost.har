€銉╂敘濡€虫健 ==========\n\tDICT_TYPE[\"PROMOTION_DISCOUNT_TYPE\"] = \"promotion_discount_type\";\n\tDICT_TYPE[\"PROMOTION_PRODUCT_SCOPE\"] = \"promotion_product_scope\";\n\tDICT_TYPE[\"PROMOTION_COUPON_TEMPLATE_VALIDITY_TYPE\"] = \"promotion_coupon_template_validity_type\";\n\tDICT_TYPE[\"PROMOTION_COUPON_STATUS\"] = \"promotion_coupon_status\";\n\tDICT_TYPE[\"PROMOTION_COUPON_TAKE_TYPE\"] = \"promotion_coupon_take_type\";\n\tDICT_TYPE[\"PROMOTION_CONDITION_TYPE\"] = \"promotion_condition_type\";\n\tDICT_TYPE[\"PROMOTION_BARGAIN_RECORD_STATUS\"] = \"promotion_bargain_record_status\";\n\tDICT_TYPE[\"PROMOTION_COMBINATION_RECORD_STATUS\"] = \"promotion_combination_record_status\";\n\tDICT_TYPE[\"PROMOTION_BANNER_POSITION\"] = \"promotion_banner_position\";\n\t// ========== AI - 娴滃搫浼愰弲楦垮厴濡€虫健  ==========\n\tDICT_TYPE[\"AI_PLATFORM\"] = \"ai_platform\";\n\tDICT_TYPE[\"AI_MODEL_TYPE\"] = \"ai_model_type\";\n\tDICT_TYPE[\"AI_IMAGE_STATUS\"] = \"ai_image_status\";\n\tDICT_TYPE[\"AI_MUSIC_STATUS\"] = \"ai_music_status\";\n\tDICT_TYPE[\"AI_GENERATE_MODE\"] = \"ai_generate_mode\";\n\tDICT_TYPE[\"AI_WRITE_TYPE\"] = \"ai_write_type\";\n\tDICT_TYPE[\"AI_WRITE_LENGTH\"] = \"ai_write_length\";\n\tDICT_TYPE[\"AI_WRITE_FORMAT\"] = \"ai_write_format\";\n\tDICT_TYPE[\"AI_WRITE_TONE\"] = \"ai_write_tone\";\n\tDICT_TYPE[\"AI_WRITE_LANGUAGE\"] = \"ai_write_language\";\n\tDICT_TYPE[\"AI_MCP_CLIENT_NAME\"] = \"ai_mcp_client_name\";\n\t// ========== IM - 閸楄櫕妞傞柅姘愁唵濡€虫健  ==========\n\tDICT_TYPE[\"IM_CONTENT_TYPE\"] = \"im_content_type\";\n\tDICT_TYPE[\"IM_MESSAGE_STATUS\"] = \"im_message_status\";\n\tDICT_TYPE[\"IM_MESSAGE_RECEIPT_STATUS\"] = \"im_message_receipt_status\";\n\tDICT_TYPE[\"IM_FRIEND_STATUS\"] = \"im_friend_status\";\n\tDICT_TYPE[\"IM_FRIEND_ADD_SOURCE\"] = \"im_friend_add_source\";\n\tDICT_TYPE[\"IM_FRIEND_REQUEST_HANDLE_RESULT\"] = \"im_friend_request_handle_result\";\n\tDICT_TYPE[\"IM_GROUP_STATUS\"] = \"im_group_status\";\n\tDICT_TYPE[\"IM_GROUP_MEMBER_ROLE\"] = \"im_group_me