DictOptions(dictType);\n\t// 鏉烆剚宕查幋?number 缁鐎烽惃?NumberDictDataType 缁鐎?\n\t// why 闂団偓鐟曚胶澹掑▓濠呮祮閹诡澁绱伴柆鍨帳 IDEA 閸?v-for=\"dict in getIntDictOptions(...)\" 閺冭绱漞l-option 閻?key 娴兼艾鎲＄拃?\n\tconst dictOption = [];\n\tdictOptions.forEach((dict) => {\n\t\tdictOption.push({\n\t\t\t...dict,\n\t\t\tvalue: parseInt(dict.value + \"\")\n\t\t});\n\t});\n\treturn dictOption;\n};\nexport const getStrDictOptions = (dictType) => {\n\t// 閼惧嘲绶遍柅姘辨暏閻?DictDataType 閸掓銆?\n\tconst dictOptions = getDictOptions(dictType);\n\t// 鏉烆剚宕查幋?string 缁鐎烽惃?StringDictDataType 缁鐎?\n\t// why 闂団偓鐟曚胶澹掑▓濠呮祮閹诡澁绱伴柆鍨帳 IDEA 閸?v-for=\"dict in getStrDictOptions(...)\" 閺冭绱漞l-option 閻?key 娴兼艾鎲＄拃?\n\tconst dictOption = [];\n\tdictOptions.forEach((dict) => {\n\t\tdictOption.push({\n\t\t\t...dict,\n\t\t\tvalue: dict.value + \"\"\n\t\t});\n\t});\n\treturn dictOption;\n};\nexport const getBoolDictOptions = (dictType) => {\n\tconst dictOption = [];\n\tconst dictOptions = getDictOptions(dictType);\n\tdictOptions.forEach((dict) => {\n\t\tdictOption.push({\n\t\t\t...dict,\n\t\t\tvalue: dict.value + \"\" === \"true\"\n\t\t});\n\t});\n\treturn dictOption;\n};\n/**\n* 閼惧嘲褰囬幐鍥х暰鐎涙鍚€缁鐎烽惃鍕瘹鐎规艾鈧厧顕惔鏃傛畱鐎涙鍚€鐎电钖?\n* @param dictType 鐎涙鍚€缁鐎?\n* @param value 鐎涙鍚€閸?\n* @return DictDataType 鐎涙鍚€鐎电钖?\n*/\nexport const getDictObj = (dictType, value) => {\n\tconst dictOptions = getDictOptions(dictType);\n\tfor (const dict of dictOptions) {\n\t\tif (dict.value === value + \"\") {\n\t\t\treturn dict;\n\t\t}\n\t}\n};\n/**\n* 閼惧嘲绶辩€涙鍚€閺佺増宓侀惃鍕瀮閺堫剙鐫嶇粈?\n*\n* @param dictType 鐎涙鍚€缁鐎?\n* @param value 鐎涙鍚€閺佺増宓侀惃鍕偓?\n* @return 鐎涙鍚€閸氬秶袨\n*/\nexport const getDictLabel = (dictType, value) => {\n\tconst dictOptions = getDictOptions(dictType);\n\tconst dictLabel = ref(\"\");\n\tdictOptions.forEach((dict) => {\n\t\tif (dict.value === value + \"\") {\n\t\t\tdictLabel.value = dict.label;\n\t\t}\n\t});\n\treturn dictLabel.value;\n};\nexport let DICT_TYPE = /* @__PURE__ */ function(DICT_TYPE) {\n\tDICT_TYPE[\"USER_TYPE\"] = \"user_type\";\n\tDICT_TYPE[\"COMMON_STATUS\"] = \"common_status\";\n\tDICT_TYPE[\"TERMINAL\"] = \"terminal\";\n\tDICT_TYPE[\"DATE_INTERVAL\"] = \"date_interval\";\n\t// ========== SYSTEM 濡€虫健 ==========\n\tDICT_TYPE[\"SYSTEM_USER_SEX\"] = \"system_user_sex\";\n\tDICT_TYPE[\"SYSTEM_MENU_TYPE\"] = \"system_menu_type\";\n\tDICT_TYPE[\"SYSTEM_ROLE_TYPE\"] = \"system_role_type\";\n\tDICT_TYPE[\"SYSTEM_DATA_SCOPE\"] = \"system_data_scope\";\n\tDICT_TYPE[\"SYSTEM_NOTICE_TYPE\"] = \"system_notice_type\";\n\tDICT_TYPE[\"SYSTEM_LOGIN_TYPE\"] = \"system_login_type\";\n\tDICT_TYPE[\"SYSTEM_LOGIN_RESULT\"] = \"system_login_result\";\n\tDICT_TYPE[\"SYSTEM_SMS_CHANNEL_CODE\"] = \"system_sms_channel_code\";\n\tDICT_TYPE[\"SYSTEM_SMS_TEMPLATE_TYPE\"] = \"system_sms_template_type\";\n\tDICT_TYPE[\"SYSTEM_SMS_SEND_STATUS\"] = \"system_sms_send_status\";\n\tDICT_TYPE[\"SYSTEM_SMS_RECEIVE_STATUS\"] = \"system_sms_receive_status\";\n\tDICT_TYPE[\"SYSTEM_OAUTH2_GRANT_TYPE\"] = \"system_oauth2_grant_type\";\n\tDICT_TYPE[\"SYSTEM_MAIL_SEND_STATUS\"] = \"system_mail_send_status\";\n\tDICT_TYPE[\"SYSTEM_NOTIFY_TEMPLATE_TYPE\"] = \"system_notify_template_type\";\n\tDICT_TYPE[\"SYSTEM_SOCIAL_TYPE\"] = \"system_social_type\";\n\t// ========== INFRA 濡€虫健 ==========\n\tDICT_TYPE[\"INFRA_BOOLEAN_STRING\"] = \"infra_boolean_string\";\n\tDICT_TYPE[\"INFRA_JOB_STATUS\"] = \"infra_job_status\";\n\tDICT_TYPE[\"INFRA_JOB_LOG_STATUS\"] = \"infra_job_log_status\";\n\tDICT_TYPE[\"INFRA_API_ERROR_LOG_PROCESS_STATUS\"] = \"infra_api_error_log_process_status\";\n\tDICT_TYPE[\"INFRA_CONFIG_TYPE\"] = \"infra_config_type\";\n\tDICT_TYPE[\"INFRA_CODEGEN_TEMPLATE_TYPE\"] = \"infra_codegen_template_type\";\n\tDICT_TYPE[\"INFRA_CODEGEN_FRONT_TYPE\"] = \"infra_codegen_front_type\";\n\tDICT_TYPE[\"INFRA_CODEGEN_SCENE\"] = \"infra_codegen_scene\";\n\tDICT_TYPE[\"INFRA_FILE_STORAGE\"] = \"infra_file_storage\";\n\tDICT_TYPE[\"INFRA_OPERATE_TYPE\"] = \"infra_operate_type\";\n\t// ========== BPM 濡€虫健 ==========\n\tDICT_TYPE[\"BPM_