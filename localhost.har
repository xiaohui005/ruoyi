ext/javascript","text":"import router from \"/src/router/index.ts?t=1783089101375\";\nimport { isRelogin } from \"/src/config/axios/service.ts?t=1783089101375\";\nimport { getAccessToken } from \"/src/utils/auth.ts\";\nimport { useTitle } from \"/src/hooks/web/useTitle.ts\";\nimport { useNProgress } from \"/src/hooks/web/useNProgress.ts\";\nimport { usePageLoading } from \"/src/hooks/web/usePageLoading.ts\";\nimport { useDictStoreWithOut } from \"/src/store/modules/dict.ts?t=1783089101375\";\nimport { useUserStoreWithOut } from \"/src/store/modules/user.ts?t=1783089101375\";\nimport { usePermissionStoreWithOut } from \"/src/store/modules/permission.ts?t=1783089101375\";\nimport { parseRouteLocation } from \"/src/utils/routeParams.ts\";\nconst { start, done } = useNProgress();\nconst { loadStart, loadDone } = usePageLoading();\n// 路由不重定向白名单\nconst whiteList = [\n\t\"/login\",\n\t\"/social-login\",\n\t\"/auth-redirect\",\n\t\"/bind\",\n\t\"/register\",\n\t\"/oauthLogin/gitee\"\n];\n// 路由加载前\nrouter.beforeEach(async (to, from, next) => {\n\tstart();\n\tloadStart();\n\tif (getAccessToken()) {\n\t\tif (to.path === \"/login\") {\n\t\t\tnext({ path: \"/\" });\n\t\t} else {\n\t\t\tconst dictStore = useDictStoreWithOut();\n\t\t\tconst userStore = useUserStoreWithOut();\n\t\t\tconst permissionStore = usePermissionStoreWithOut();\n\t\t\t// 异步加载字典\n\t\t\t// 另外，间接 issue：https://gitee.com/yudaocode/yudao-ui-admin-vue3/issues/ID9FLI\n\t\t\tif (!dictStore.getIsSetDict) {\n\t\t\t\tdictStore.setDictMap().then();\n\t\t\t}\n\t\t\tif (!userStore.getIsSetUser) {\n\t\t\t\tisRelogin.show = true;\n\t\t\t\tawait userStore.setUserInfoAction();\n\t\t\t\tisRelogin.show = false;\n\t\t\t\t// 后端过滤菜单\n\t\t\t\tawait permissionStore.generateRoutes();\n\t\t\t\tpermissionStore.getAddRouters.forEach((route) => {\n\t\t\t\t\trouter.addRoute(route);\n\t\t\t\t});\n\t\t\t\tconst redirectPath = from.query.redirect;\n\t\t\t\t// 修复跳转时不带参数的问题\n\t\t\t\tconst redirect = typeof redirectPath === \"string\" ? redirectPath : to.fullPath;\n\t\t\t\tconst redirectLocation = parseRouteLocation(redirect);\n\t\t\t\tconst nextData = to.fullPath === redirect ? {\n\t\t\t\t\t...to,\n\t\t\t\t\treplace: true\n\t\t\t\t} : {\n\t\t\t\t\t...redirectLocation,\n\t\t\t\t\treplace: true\n\t\t\t\t};\n\t\t\t\tnext(nextData);\n\t\t\t} else {\n\t\t\t\tnext();\n\t\t\t}\n\t\t}\n\t} else {\n\t\tif (whiteList.indexOf(to.path) !== -1) {\n\t\t\tnext();\n\t\t} else {\n\t\t\tnext(`/login?redirect=${encodeURIComponent(to.fullPath)}`);\n\t\t}\n\t}\n});\nrouter.afterEach((to) => {\n\tuseTitle(to?.meta?.title);\n\tdone();\n\tloadDone();\n});\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":2.234},"_resourceType":"script"},{"startedDateTime":"2026-07-03T15:45:32.074Z","time":1.822,"request":{"method":"GET","url":"http://localhost/src/utils/Logger.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost"},{"name":"Origin","value":"http://localhost"},{"name":"Referer","value":"http://localhost/src/main.ts?t=1783089101375"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Origin","value":"http://localhost"},{"name":"Cache-Control","value":"no-cach